{
  "name": "data_board",
  "version": "1.0.0",
  "description": "",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "rimraf dist && swc ./src -d dist",
    "start": "node dist/src/index.js",
    "dev": "concurrently \"pnpm watch-compile\" \"pnpm watch-dev\"",
    "watch-compile": "swc ./src -w -d dist --sync",
    "watch-dev": "nodemon --watch \"dist/**/*\" -e js --delay 300ms ./dist/src/index.js",
    "dev-simple": "swc ./src -w -d dist --sync | nodemon --watch \"dist/**/*\" -e js --delay 300ms ./dist/src/index.js",
    "dev:debug": "concurrently \"pnpm watch-compile\" \"pnpm watch-dev-debug\"",
    "watch-dev-debug": "nodemon --inspect=0.0.0.0:9229 --watch \"dist/**/*\" -e js --delay 300ms ./dist/src/index.js",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "drizzle:generate": "echo 'deprecated, use db:generate' && pnpm db:generate",
    "drizzle:migrate": "echo 'deprecated, use db:migrate' && pnpm db:migrate",
    "drizzle:push": "echo 'deprecated, use db:push' && pnpm db:push",
    "drizzle:studio": "echo 'deprecated, use db:studio' && pnpm db:studio"
  },
  "keywords": [],
  "author": "",
  "license": "SEE LICENSE IN LICENSE.md",
  "packageManager": "pnpm@10.15.0",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1036.0",
    "@hono/node-server": "^1.19.9",
    "@hono/zod-validator": "^0.7.6",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@types/busboy": "^1.5.4",
    "@types/multer": "^2.0.0",
    "aws-msk-iam-sasl-signer-js": "^1.0.1",
    "axios": "^1.13.1",
    "busboy": "^1.6.0",
    "cheerio": "^1.0.0",
    "countries-and-timezones": "^3.9.0",
    "cron": "^3.1.7",
    "csv-parse": "^6.2.1",
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.45.1",
    "dropbox": "^10.34.0",
    "express": "^5.1.0",
    "form-data": "^4.0.5",
    "googleapis": "^118.0.0",
    "hono": "^4.11.7",
    "ioredis": "^5.10.1",
    "js-yaml": "^4.1.1",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.1",
    "kafkajs": "^2.2.4",
    "mongoose": "^8.18.1",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "node-schedule": "^2.1.1",
    "oxigraph": "^0.5.8",
    "pg": "^8.17.1",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "xlsx": "0.18.5",
    "zod": "^4.3.6"
  },
  "pnpm": {
    "overrides": {
      "jws": ">=4.0.1",
      "qs": ">=6.14.1",
      "esbuild": ">=0.25.0"
    }
  },
  "devDependencies": {
    "@swc/cli": "^0.7.8",
    "@swc/core": "^1.13.5",
    "@types/express": "^5.0.3",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/jszip": "^3.4.1",
    "@types/mongoose": "^5.11.97",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.4.0",
    "@types/node-schedule": "^2.1.7",
    "@types/pg": "^8.16.0",
    "@vitest/coverage-v8": "^4.0.17",
    "@vitest/ui": "^4.0.17",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.8",
    "mongodb": "^6.18.0",
    "nodemon": "^3.1.10",
    "rimraf": "^6.1.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2",
    "vitest": "^4.0.17",
    "yargs": "^18.0.0"
  }
}
