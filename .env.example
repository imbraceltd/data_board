# ─── App ──────────────────────────────────────────────────────────────────────
PORT=8081
NODE_ENV=development
WEBAPP_URL=http://localhost:3000

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
DB_TYPE=postgres
POSTGRES_URL=postgres://postgres:postgres@localhost:5432/data_board

# ─── Internal services ────────────────────────────────────────────────────────
FS_SERVICE_URL=http://localhost:8866/api/files
AI_SERVICE_URL=http://localhost:8868/api/v1
AI_PROXY_URL=http://localhost:3003
APP_GATEWAY_HOST=http://localhost:8869
CHANNEL_SERVICE_URL=http://localhost:4100
IPS_SERVICE_URL=http://localhost:8870/api/v1
PLATFORM_SERVICE_HOST=http://localhost:6040
MARKETPLACE_URL=http://localhost:9982
MESSAGE_SUGGESTION_URL=

# ─── AI / MongoDB for assistant data (optional) ───────────────────────────────
AI_MONGO_URL=
AI_MONGO_DB_NAME=
AI_ASSISTANTS_COLLECTION=openai_assistants

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Kafka (set KAFKA_ENABLED=false to disable) ───────────────────────────────
KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=data-board-service
KAFKA_AUTH_METHOD=plain
KAFKA_USE_SSL=false
KAFKA_USE_SASL=false
KAFKA_USE_SSL_REJECT_UNAUTHORIZED=true
KAFKA_AWS_REGION=us-east-1
KAFKA_SASL_MECHANISM=plain
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# ─── AWS S3 ───────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# ─── Cloud storage integrations ───────────────────────────────────────────────
# OneDrive
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
ONEDRIVE_TENANT_ID=
ONEDRIVE_REDIRECT_URI=http://localhost:8081/api/auth/onedrive/callback

# Google Drive
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:8081/api/auth/google-drive/callback
GOOGLE_DRIVE_API_KEY=

# Dropbox
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REDIRECT_URI=http://localhost:8081/api/auth/dropbox/callback

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=noreply@example.com
SMTP_FROM_NAME=Data Board
